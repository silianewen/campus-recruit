# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel

# Local PowerShell script that holds Supabase + HR credentials.
# Only this exact file at repo root is ignored; scripts/set-env*.ps1 helpers stay tracked.
/campus_recruit.ps1

# One-off diff/review files generated by analysis tools — should not land
# in the repo.
/review_diff.txt
/review_notes/

# Stray copies of the user-level Claude / OpenSpec config that occasionally
# land inside /docs when the tools dump there. The repo's own OpenSpec state
# lives at /openspec/ (not under /docs/).
/docs/.claude/
/docs/openspec/

# Stash for the 6 logo PNGs that were delivered with the original bundle
# but the user wants to replace. When the user uploads new logos, drop them
# back into public/logos/ and delete this folder.
/.logo-backup/

# Keep the public/logos/ folder itself under version control so the path
# exists when the user drops their replacement logos in. (Folder-only
# entries aren't tracked by git; the .gitkeep below handles it.)

# Empty placeholder files that snuck into earlier commits. Both were
# accidentally added with 0 bytes; the real content lives elsewhere.
# If you ever need a placeholder scratch file, name it `.scratch.txt`
# or similar so it stays out of git.
/companies_code.txt
/requirements.txt

# Local Vite dev-server artifacts (Vite occasionally writes here when
# it can't place a file at its destination).
/.vite/

